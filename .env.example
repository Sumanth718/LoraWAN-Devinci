# Copy to .env and replace every CHANGE_ME.  Never commit .env.
# Quick way to generate values:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- core
POSTGRES_PASSWORD=CHANGE_ME
CHIRPSTACK_API_SECRET=CHANGE_ME
# 0.0.0.0 = UI reachable on http://<host>:8080 (LAN testing).
# 127.0.0.1 = only through Caddy/HTTPS (use with the "public" profile).
CHIRPSTACK_UI_BIND=0.0.0.0

# --- dashboards profile
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=devinci
INFLUXDB_BUCKET=lorawan
INFLUXDB_RETENTION=52w
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# 0.0.0.0 to reach Grafana directly on :3000 without Caddy
GRAFANA_BIND=127.0.0.1

# --- public profile
# localhost until the DSI creates the DNS record, then lorawan.devinci.fr
DOMAIN=localhost
# Base URL Grafana generates links for (it is served under <PUBLIC_URL>/grafana/).
# Without Caddy, use http://<host-ip>:3000 and GRAFANA_BIND=0.0.0.0
PUBLIC_URL=https://localhost
